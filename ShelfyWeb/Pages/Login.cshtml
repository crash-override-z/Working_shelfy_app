@page
@model ShelfyWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Admin Sign In";
}

<div class="container py-5" style="max-width: 480px;">
    <h1 class="mb-4">Admin Sign In</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Admin password</label>
            <input asp-for="Password" type="password" class="form-control"
                   autocomplete="current-password" required />
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me on this device</label>
        </div>

        <button type="submit" class="btn btn-primary">Sign in</button>
        <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Back</a>
    </form>
</div>