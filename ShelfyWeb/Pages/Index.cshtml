@page
@using System.Globalization
@model ShelfyWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Place an Order";
}

<div class="container py-4">
    <h1 class="mb-3">Place a Sushi Order</h1>
    <p class="text-muted">Choose your rolls and pickup time. Prices are calculated when you place your order.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ConfirmationTicketId))
    {
        <div class="alert alert-success" role="status">
            Your order was saved! Your ticket number is
            <strong>@Model.ConfirmationTicketId</strong>.
        </div>
    }

    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="mb-4">
            <label asp-for="CustomerName" class="form-label">Your name</label>
            <input asp-for="CustomerName" class="form-control" maxlength="100" />
        </div>

        <h2 class="h4">Menu</h2>
        <p class="text-muted">Enter a quantity from 0 to 99 for each roll. Leave items you don’t want at 0.</p>

        <div class="row g-3 mb-4">
            @for (int i = 0; i < IndexModel.Menu.Length; i++)
            {
                var roll = IndexModel.Menu[i];
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <label for="quantity-@i" class="form-label mb-1">@roll.Name</label>
                                <div class="text-muted">$@roll.Price.ToString("F2") each</div>
                            </div>
                            <input
                                type="number"
                                class="form-control"
                                style="max-width: 100px"
                                id="quantity-@i"
                                name="Quantities[@i]"
                                value="@Model.QuantityAt(i)"
                                min="0"
                                max="99" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="PickupDay" class="form-label">Pickup day</label>
                <select asp-for="PickupDay" class="form-select">
                    <option value="">Choose a weekday</option>
                    @foreach (var day in IndexModel.PickupDays)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="PickupTime" class="form-label">Pickup time</label>
                <select asp-for="PickupTime" class="form-select">
                    <option value="">Choose a time</option>
                    @for (int totalMinutes = 12 * 60; totalMinutes <= 20 * 60; totalMinutes += 15)
                    {
                        var time = DateTime.Today
                            .AddMinutes(totalMinutes)
                            .ToString("h:mm tt", CultureInfo.InvariantCulture);
                        <option value="@time">@time</option>
                    }
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Place Order</button>
    </form>
</div>