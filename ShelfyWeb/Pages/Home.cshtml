@page
@{
    ViewData["Title"] = "Home";
}

<!-- Image / hero area -->
<main class="container py-3">
    <img src="https://static.vecteezy.com/system/resources/thumbnails/008/695/917/small/no-image-available-icon-simple-two-colors-template-for-no-image-or-picture-coming-soon-and-placeholder-illustration-isolated-on-white-background-vector.jpg"
         alt="Shelfy logo" 
         class="d-block mx-auto mb-3"
         style="max-width: 200px;"/>

    <!-- // TEXT // Heading and description -->
    <h1 class="h3 mb-2">Take a Shelfy</h1>
    <h1 class="h3 mb-2">Check the Shelfy</h1>
    <p class="text-muted mb-4">Real time stock updates | Reserve orders | Snap to earn points
    </p>


   <!--// BUTTONS //  -->
    <div class="d-grid gap-3">
        <!-- Main action buttons -->
        <button type="button" class="btn btn-primary btn-lg">Check nearby shelves</button>
        <button type="button" class="btn btn-secondary btn-lg"> Take a Shelfy</button>
    </div>

<!-- Main action buttons -->
    <div class="d-flex gap-3 mt-3">
        <!-- Main action buttons -->
        <button type="button" class="btn btn-primary btn-lg">In Stock</button>
        <button type="button" class="btn btn-secondary btn-lg"> Low Stock</button>
    </div>



    <div class="mt-4">
        <h2 class="h5">Stock choices</h2>
        <p class="text-muted">Select a stock to view its details.</p>
    </div>

    <!-- Stock choices -->
</main>
