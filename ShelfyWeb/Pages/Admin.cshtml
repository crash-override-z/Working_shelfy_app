@page
@model ShelfyWeb.Pages.AdminModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Store Orders</h1> 
    <a asp-page="/Logout" class="btn btn-outline-secondary me-3">Sign out</a>
</div>

    <div class="alert alert-success">
        <strong>Total revenue (excluding cancelled orders):</strong>
        $@Model.TotalRevenue.ToString("F2")
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">
            No orders are in the database yet.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var order in Model.Orders)
            {
                <div id="order-@order.Id" class="list-group-item mb-3 order-card status-@order.Status.ToLowerInvariant()">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h2 class="h5 mb-1">Ticket @order.TicketId</h2>
                            <div>Customer: @order.CustomerName</div>
                            <div>Pickup: @order.PickupSlot</div>
                            <div>Total: $@order.TotalPrice.ToString("F2")</div>
                            <div class="mt-2">
                                <strong>Items:</strong>
                                @if (order.Items.Count == 0)
                                {
                                    <span class="text-muted">No item details saved for this order.</span>
                                }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in order.Items)
                                        {
                                            <li>@item.Quantity × @item.RollName — $@item.UnitPrice.ToString("F2") each</li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div>Status: <strong>@order.Status</strong></div>
                            <div class="text-muted small">
                                Created: @order.CreatedAt.ToLocalTime().ToString("g")
                            </div>
                        </div>

                        <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-2 align-items-center" data-auto-save-status>
                            <input type="hidden" name="id" value="@order.Id" />
                            <label class="visually-hidden" for="status-@order.Id">Order status</label>
                            <select id="status-@order.Id" name="status" class="form-select status-select status-@order.Status.ToLowerInvariant()">
                                @foreach (var status in ShelfyWeb.Pages.AdminModel.StatusOptions)
                                {
                                    <option value="@status" selected="@(order.Status == status ? "selected" : null)">
                                        @status
                                    </option>
                                }
                            </select>
                        </form>
                    </div>
                </div>
            }
        </div>

    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll("form[data-auto-save-status] select").forEach(select => {
            select.addEventListener("change", () => select.form.requestSubmit());
        });

        if (window.location.hash.startsWith("#order-")) {
            const orderCard = document.getElementById(window.location.hash.slice(1));
            if (orderCard) {
                setTimeout(() => orderCard.scrollIntoView({ block: "start" }), 100);
            }
        }
    </script>
}